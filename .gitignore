# Secrets - never upload API keys
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python environments
.venv/
venv/
myenv/
__pycache__/
*.py[cod]
.pytest_cache/

# Backup files
*.bak
*.bak.*
*.backup
*.pre_*
*.before_*
app.before_*.py
app.py.pre_*.bak

# Logs
logs/
*.log

# Original source PDFs remain local
data/raw/

# Evaluation backups and temporary results
evaluation/archive/
evaluation/*backup*
evaluation/*.bak
evaluation/*.retry_working.json
evaluation/*.pre_*
evaluation/*.before_*

# Local debugging scripts
debug_*.py
